# Copier ce fichier en ".env" et remplir avec tes vraies clés
# Ne jamais commiter le fichier ".env" (déjà exclu via .gitignore)

# Clé OpenRouter — https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Clé Groq — https://console.groq.com/keys
GROQ_API_KEY=

# Supabase — facultatif, active le stockage persistant des événements
# personnalisés du calendrier éditorial (voir data/supabase_setup.sql)
# Settings > API dans ton projet Supabase
SUPABASE_URL=
SUPABASE_KEY=
